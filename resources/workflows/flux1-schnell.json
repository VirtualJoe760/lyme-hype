{
  "_meta": {
    "model": "flux1-schnell",
    "label": "Flux 1 Schnell — local, $0, Apache 2.0",
    "requiredWeights": ["checkpoints/flux1-schnell-fp8.safetensors"],
    "patch": {
      "prompt": { "node": "2", "input": "text" },
      "width": { "node": "4", "input": "width" },
      "height": { "node": "4", "input": "height" },
      "steps": { "node": "5", "input": "steps" },
      "seed": { "node": "5", "input": "seed" }
    },
    "defaults": { "steps": 4 },
    "i2i": { "latentNode": "4", "samplerNode": "5", "vaeFrom": ["1", 2] }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "flux1-schnell-fp8.safetensors" }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["1", 1] }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["1", 1] }
    },
    "4": {
      "class_type": "EmptySD3LatentImage",
      "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "seed": 0,
        "steps": 4,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": { "images": ["6", 0], "filename_prefix": "lyme" }
    }
  }
}
